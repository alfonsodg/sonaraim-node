# SonarAIM Node Environment Variables Example
NODE_ID=node-primary-01
NODE_HTTP_HOST=0.0.0.0
NODE_HTTP_PORT=8040
NODE_P2P_LISTEN_ADDR=/ip4/0.0.0.0/udp/9001
NODE_ENVELOPE_TTL_SECONDS=604800
# Optional: comma-separated bootstrap peers (/ip4/<host>/udp/<port> or host:port)
NODE_BOOTSTRAP_PEERS=/ip4/10.0.0.2/udp/9001,/ip4/10.0.0.3/udp/9001
# Optional: 64-hex STH signing seed, stable per node.
# WARNING: when unset, a process-local random seed is generated and the STH
# signer identity rotates on every restart (peers cannot pin the signer).
# NODE_STH_SIGNING_SEED=aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa
